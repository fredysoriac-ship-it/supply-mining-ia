# Copia este archivo como variables de entorno en Vercel (Project Settings → Environment Variables).
# NUNCA subas tus claves reales al repositorio.

# Proveedor de IA por defecto: anthropic (Claude) u openai (ChatGPT)
AI_DEFAULT_PROVIDER=anthropic

# Claves de IA (configura la que uses; puedes tener ambas)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Modelos (opcional; hay valores por defecto en el código)
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-4o

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # service_role, SOLO en el servidor

# Token simple para proteger la cola de revisión (lo defines tú).
# El frontend de este scaffold no lo envía todavía; mientras valides solo tú
# y la app no sea pública, puedes dejarlo vacío. Al abrir al público, ponlo.
REVIEW_TOKEN=
